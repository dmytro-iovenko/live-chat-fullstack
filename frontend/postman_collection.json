		},
		{
			"key": "firebasePassword",
			"value": "your-password"
		},
		{
			"key": "apiKey",
			"value": "your-firebase-api-key"
		},
		{
			"key": "firebaseToken",
			"value": ""
		},
		{
			"key": "chatId",
			"value": ""
		},
		{
			"key": "userId",
